{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-pico2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "476ed5fc-d4c5-4c91-b8cf-86bb84a468e4","database_name": "web-app-pico2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bfee4b8a598f4d36bfd8fa0731a8c6e0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
